generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  COORDINATOR
  INSTRUCTOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

// ─── NextAuth required models ─────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── App models ───────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  fullName String
  role     Role   @default(INSTRUCTOR)

  // Instructors optionally belong to one coordinator
  coordinatorId String?
  coordinator   User?   @relation("CoordinatorInstructors", fields: [coordinatorId], references: [id])
  instructors   User[]  @relation("CoordinatorInstructors")

  // Courses
  coursesTaught      Course[] @relation("InstructorCourses")
  coursesCoordinated Course[] @relation("CoordinatorCourses")

  // Sessions created by this user
  sessionsCreated CourseSession[]

  // Attendance records last updated by this user
  attendanceUpdated Attendance[]

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String  @id @default(cuid())
  name        String
  description String?
  isActive    Boolean @default(true)

  instructorId String
  instructor   User   @relation("InstructorCourses", fields: [instructorId], references: [id])

  coordinatorId String?
  coordinator   User?   @relation("CoordinatorCourses", fields: [coordinatorId], references: [id])

  sessions CourseSession[]
  students CourseStudent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseSession {
  id       String   @id @default(cuid())
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  title     String
  date      DateTime
  startTime String? // "09:00" format

  createdByInstructorId String
  createdByInstructor   User   @relation(fields: [createdByInstructorId], references: [id])

  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id         String    @id @default(cuid())
  fullName   String
  nationalId String    @unique
  birthDate  DateTime?

  courses    CourseStudent[]
  attendance Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Join table: student ↔ course (many-to-many)
model CourseStudent {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([courseId, studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  sessionId String
  session   CourseSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  status AttendanceStatus @default(ABSENT)
  note   String?

  updatedByUserId String
  updatedByUser   User   @relation(fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, studentId])
}
